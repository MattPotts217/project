all:
  vars:
    ansible_become: true
    ansible_ssh_private_key_file: "__ANSIBLE_SSH_PRIVATE_KEY_FILE__"
    ansible_ssh_common_args: "-F __SSH_CONFIG__"
    rke2_token: "__RKE2_TOKEN__"
    rke2_server_private_ip: "__RKE2_SERVER_PRIVATE_IP__"
    dataplane_gateway: "__DATAPLANE_GATEWAY__"

  children:
    rke2_servers:
      hosts:
__RKE2_SERVERS_HOSTS__

    rke2_agents:
      hosts:
__RKE2_AGENTS_HOSTS__

